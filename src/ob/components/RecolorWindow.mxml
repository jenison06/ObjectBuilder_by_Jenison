<s:Window xmlns:fx="http://ns.adobe.com/mxml/2009"
    xmlns:s="library://ns.adobe.com/flex/spark"
    xmlns:mx="library://ns.adobe.com/flex/mx"
    xmlns:otlib="otlib.components.*"
    width="900"
    height="720"
    minWidth="820"
    minHeight="620"
    backgroundColor="0x383838"
    showStatusBar="false"
    fontSize="11"
    title="@Resource(key='recolorTitle', bundle='strings')"
    creationComplete="creationCompleteHandler(event)"
    close="closeHandler(event)"
    keyDown="windowKeyDownHandler(event)">

    <s:layout>
        <s:VerticalLayout paddingLeft="12" paddingRight="12" paddingTop="12" paddingBottom="12" gap="10"/>
    </s:layout>

    <fx:Metadata>
        [ResourceBundle("strings")]
    </fx:Metadata>

    <fx:Script>
        <![CDATA[
            import flash.display.BitmapData;
            import flash.events.Event;
            import flash.events.KeyboardEvent;
            import flash.events.MouseEvent;
            import flash.geom.Point;
            import flash.geom.Rectangle;
            import flash.ui.Keyboard;
            import flash.utils.Dictionary;

            import mx.events.ColorPickerEvent;
            import mx.events.FlexEvent;

            import spark.components.BorderContainer;

            import otlib.animation.FrameGroup;
            import otlib.geom.Direction;
            import otlib.sprites.SpriteData;
            import otlib.things.FrameGroupType;
            import otlib.things.ThingCategory;
            import otlib.things.ThingData;
            import otlib.utils.RecolorUtils;
            import otlib.utils.SpriteExtent;

            // --------------------------------------------------------------------------
            // CONSTANTS
            // --------------------------------------------------------------------------

            public static const TOOL_EYEDROPPER:String = "eyedropper";
            public static const TOOL_BRUSH:String = "brush";
            public static const TOOL_ERASER:String = "eraser";
            public static const TOOL_WAND:String = "wand";
            public static const TOOL_RECT:String = "rect";

            private static const MASK_HISTORY_LIMIT:uint = 30;
            private static const COLOR_HISTORY_MAX:uint = 8;

            // --------------------------------------------------------------------------
            // PROPERTIES
            // --------------------------------------------------------------------------

            private var _thingData:ThingData;
            private var _baseBitmap:BitmapData;
            private var _recoloredBitmap:BitmapData;

            private var _maskBitmap:BitmapData;
            private var _maskOverlayBitmap:BitmapData;
            private var _masksByView:Dictionary = new Dictionary();
            private var _maskUndoStack:Vector.<BitmapData> = new Vector.<BitmapData>();
            private var _maskRedoStack:Vector.<BitmapData> = new Vector.<BitmapData>();
            private var _maskStrokeActive:Boolean = false;
            private var _colorHistory:Array = [];
            private var _swatchColorMap:Dictionary = new Dictionary(true);

            private var _isMouseDown:Boolean = false;
            private var _rectStartX:int = -1;
            private var _rectStartY:int = -1;

            [Bindable]
            private var _canUndoMask:Boolean = false;

            [Bindable]
            private var _canRedoMask:Boolean = false;

            private var _currentGroupType:uint = FrameGroupType.DEFAULT;
            private var _currentFrame:uint = 0;
            private var _currentLayer:uint = 0;
            private var _currentPatX:uint = 0;
            private var _currentPatY:uint = 0;

            [Bindable]
            private var _activeTool:String = TOOL_WAND;

            [Bindable]
            private var _brushSize:uint = 1;

            [Bindable]
            private var _useMask:Boolean = false;

            [Bindable]
            private var _showMaskOverlay:Boolean = true;

            [Bindable]
            private var _applyMaskToAll:Boolean = true;

            [Bindable]
            private var _sourceColor:uint = 0xFF0000;
            [Bindable]
            private var _targetColor:uint = 0x0088FF;

            [Bindable]
            private var _sourceHex:String = "FF0000";
            [Bindable]
            private var _targetHex:String = "0088FF";

            [Bindable]
            private var _previewScale:Number = 2.0;

            [Bindable]
            private var _hasDirections:Boolean = false;

            [Bindable]
            private var _hasFrames:Boolean = false;

            [Bindable]
            private var _maxFrames:uint = 1;

            [Bindable]
            private var _objectInfo:String = "";

            /** Callback onSave(recoloredThingData:ThingData, isNew:Boolean) */
            public var onSave:Function;

            // --------------------------------------------------------------------------
            // METHODS
            // --------------------------------------------------------------------------

            public function get thingData():ThingData
            {
                return _thingData;
            }

            public function set thingData(value:ThingData):void
            {
                _thingData = value;
                if (_thingData)
                {
                    var isOutfit:Boolean = (_thingData.category == ThingCategory.OUTFIT);
                    _currentPatX = isOutfit ? 2 : 1; // South
                    _currentPatY = isOutfit ? 0 : 2;

                    var fg:FrameGroup = _thingData.thing.getFrameGroup(FrameGroupType.DEFAULT);
                    if (fg)
                    {
                        _hasDirections = (fg.patternX > 1 || fg.patternY > 1);
                        _hasFrames = (fg.frames > 1);
                        _maxFrames = fg.frames;
                    }

                    _objectInfo = resourceManager.getString("strings", _thingData.category) + " #" + _thingData.id;
                    rebuildBaseBitmap();
                }
            }

            private function creationCompleteHandler(event:FlexEvent):void
            {
                updateDirectionButtons();
                updateToolButtons();
                updatePreview();
            }

            private function closeHandler(event:Event):void
            {
                disposeBitmaps();
            }

            private function disposeBitmaps():void
            {
                if (_baseBitmap)
                {
                    _baseBitmap.dispose();
                    _baseBitmap = null;
                }
                if (_recoloredBitmap)
                {
                    _recoloredBitmap.dispose();
                    _recoloredBitmap = null;
                }
                if (_maskBitmap)
                {
                    _maskBitmap.dispose();
                    _maskBitmap = null;
                }
                if (_maskOverlayBitmap)
                {
                    _maskOverlayBitmap.dispose();
                    _maskOverlayBitmap = null;
                }
                clearMaskHistory();
                for (var key:String in _masksByView)
                {
                    var viewMask:BitmapData = _masksByView[key] as BitmapData;
                    if (viewMask)
                        viewMask.dispose();
                    delete _masksByView[key];
                }
            }

            private function clearMaskHistory():void
            {
                var i:int;
                for (i = 0; i < _maskUndoStack.length; i++)
                    _maskUndoStack[i].dispose();
                _maskUndoStack.length = 0;
                for (i = 0; i < _maskRedoStack.length; i++)
                    _maskRedoStack[i].dispose();
                _maskRedoStack.length = 0;
                updateMaskHistoryButtons();
            }

            private function updateMaskHistoryButtons():void
            {
                _canUndoMask = _maskUndoStack.length > 0;
                _canRedoMask = _maskRedoStack.length > 0;
            }

            private function pushMaskHistory():void
            {
                ensureMaskExists();
                if (!_maskBitmap)
                    return;

                _maskUndoStack.push(_maskBitmap.clone());
                while (_maskUndoStack.length > MASK_HISTORY_LIMIT)
                {
                    var old:BitmapData = _maskUndoStack.shift();
                    old.dispose();
                }

                for (var i:int = 0; i < _maskRedoStack.length; i++)
                    _maskRedoStack[i].dispose();
                _maskRedoStack.length = 0;
                updateMaskHistoryButtons();
            }

            private function undoMask():void
            {
                if (_maskUndoStack.length == 0)
                    return;

                ensureMaskExists();
                _maskRedoStack.push(_maskBitmap.clone());
                var prev:BitmapData = _maskUndoStack.pop();
                _maskBitmap.copyPixels(prev, prev.rect, new Point(0, 0));
                prev.dispose();
                updateMaskOverlay();
                updatePreview();
                updateMaskHistoryButtons();
            }

            private function redoMask():void
            {
                if (_maskRedoStack.length == 0)
                    return;

                ensureMaskExists();
                _maskUndoStack.push(_maskBitmap.clone());
                var next:BitmapData = _maskRedoStack.pop();
                _maskBitmap.copyPixels(next, next.rect, new Point(0, 0));
                next.dispose();
                updateMaskOverlay();
                updatePreview();
                updateMaskHistoryButtons();
            }

            private function getCurrentViewKey():String
            {
                return _currentGroupType + "_" + _currentFrame + "_" + _currentPatX + "_" + _currentPatY;
            }

            private function saveCurrentMaskToView():void
            {
                if (!_maskBitmap)
                    return;

                var key:String = getCurrentViewKey();
                var old:BitmapData = _masksByView[key] as BitmapData;
                if (old)
                    old.dispose();
                _masksByView[key] = _maskBitmap.clone();
            }

            private function restoreMaskForView():void
            {
                ensureMaskExists();
                if (!_maskBitmap)
                    return;

                var saved:BitmapData = _masksByView[getCurrentViewKey()] as BitmapData;
                if (saved && saved.width == _maskBitmap.width && saved.height == _maskBitmap.height)
                    _maskBitmap.copyPixels(saved, saved.rect, new Point(0, 0));
                else
                    _maskBitmap.fillRect(_maskBitmap.rect, 0x00000000);
            }

            private function copyMaskToAllViews():void
            {
                ensureMaskExists();
                if (!_maskBitmap || !_thingData || !_thingData.thing)
                    return;

                var fg:FrameGroup = _thingData.thing.getFrameGroup(_currentGroupType);
                if (!fg)
                    fg = _thingData.thing.getFrameGroup(FrameGroupType.DEFAULT);
                if (!fg)
                    return;

                for (var f:uint = 0; f < fg.frames; f++)
                {
                    for (var px:uint = 0; px < fg.patternX; px++)
                    {
                        for (var py:uint = 0; py < fg.patternY; py++)
                        {
                            var key:String = _currentGroupType + "_" + f + "_" + px + "_" + py;
                            var old:BitmapData = _masksByView[key] as BitmapData;
                            if (old)
                                old.dispose();
                            _masksByView[key] = _maskBitmap.clone();
                        }
                    }
                }

                _applyMaskToAll = true;
                if (applyAllFramesCheckBox)
                    applyAllFramesCheckBox.selected = true;
            }

            private function addColorToHistory(color:uint):void
            {
                color = color & 0x00FFFFFF;
                var idx:int = _colorHistory.indexOf(color);
                if (idx >= 0)
                    _colorHistory.splice(idx, 1);
                _colorHistory.unshift(color);
                while (_colorHistory.length > COLOR_HISTORY_MAX)
                    _colorHistory.pop();
                rebuildColorHistoryUI();
            }

            private function rebuildColorHistoryUI():void
            {
                if (!colorHistoryGroup)
                    return;

                colorHistoryGroup.removeAllElements();
                _swatchColorMap = new Dictionary(true);

                for (var i:int = 0; i < _colorHistory.length; i++)
                {
                    var color:uint = uint(_colorHistory[i]);
                    var swatch:BorderContainer = new BorderContainer();
                    swatch.width = 18;
                    swatch.height = 18;
                    swatch.setStyle("backgroundColor", color);
                    swatch.setStyle("borderColor", 0x111111);
                    swatch.setStyle("borderWeight", 1);
                    swatch.setStyle("cornerRadius", 2);
                    swatch.buttonMode = true;
                    swatch.useHandCursor = true;
                    swatch.toolTip = "#" + padHex(color.toString(16).toUpperCase());
                    swatch.addEventListener(MouseEvent.CLICK, onHistorySwatchClick);
                    _swatchColorMap[swatch] = color;
                    colorHistoryGroup.addElement(swatch);
                }
            }

            private function onHistorySwatchClick(event:MouseEvent):void
            {
                if (_swatchColorMap[event.currentTarget] == undefined)
                    return;
                pickHistoryColor(uint(_swatchColorMap[event.currentTarget]));
            }

            private function pickHistoryColor(color:uint):void
            {
                _sourceColor = color & 0x00FFFFFF;
                _sourceHex = padHex(_sourceColor.toString(16).toUpperCase());
                if (sourceColorPicker)
                    sourceColorPicker.selectedColor = _sourceColor;
                if (enableReplaceCheckBox)
                    enableReplaceCheckBox.selected = true;
                updatePreview();
            }

            private function applyPreset(preset:String):void
            {
                if (enableHslCheckBox)
                    enableHslCheckBox.selected = true;
                if (colorizeCheckBox)
                    colorizeCheckBox.selected = true;
                if (enableReplaceCheckBox)
                    enableReplaceCheckBox.selected = false;

                switch (preset)
                {
                    case "shiny":
                        hueSlider.value = 45;
                        satSlider.value = 85;
                        lightSlider.value = 15;
                        break;
                    case "fire":
                        hueSlider.value = 15;
                        satSlider.value = 95;
                        lightSlider.value = 5;
                        break;
                    case "ice":
                        hueSlider.value = 200;
                        satSlider.value = 70;
                        lightSlider.value = 10;
                        break;
                    case "poison":
                        hueSlider.value = 110;
                        satSlider.value = 80;
                        lightSlider.value = -5;
                        break;
                    case "shadow":
                        hueSlider.value = 270;
                        satSlider.value = 40;
                        lightSlider.value = -25;
                        break;
                    case "blood":
                        hueSlider.value = 0;
                        satSlider.value = 90;
                        lightSlider.value = -10;
                        break;
                }
                updatePreview();
            }

            private function windowKeyDownHandler(event:KeyboardEvent):void
            {
                if (!event.ctrlKey)
                    return;

                if (event.keyCode == Keyboard.Z)
                {
                    undoMask();
                    event.preventDefault();
                }
                else if (event.keyCode == Keyboard.Y)
                {
                    redoMask();
                    event.preventDefault();
                }
            }

            private function ensureMaskExists():void
            {
                if (!_baseBitmap) return;

                if (!_maskBitmap || _maskBitmap.width != _baseBitmap.width || _maskBitmap.height != _baseBitmap.height)
                {
                    if (_maskBitmap) _maskBitmap.dispose();
                    _maskBitmap = new BitmapData(_baseBitmap.width, _baseBitmap.height, true, 0x00000000);
                }

                if (!_maskOverlayBitmap || _maskOverlayBitmap.width != _baseBitmap.width || _maskOverlayBitmap.height != _baseBitmap.height)
                {
                    if (_maskOverlayBitmap) _maskOverlayBitmap.dispose();
                    _maskOverlayBitmap = new BitmapData(_baseBitmap.width, _baseBitmap.height, true, 0x00000000);
                }
            }

            private function rebuildBaseBitmap():void
            {
                if (_baseBitmap)
                {
                    _baseBitmap.dispose();
                    _baseBitmap = null;
                }
                _baseBitmap = composePreviewBitmap();
                ensureMaskExists();
                updateMaskOverlay();
                updatePreview();
            }

            private function composePreviewBitmap():BitmapData
            {
                if (!_thingData || !_thingData.thing) return null;

                var frameGroup:FrameGroup = _thingData.thing.getFrameGroup(_currentGroupType);
                if (!frameGroup)
                    frameGroup = _thingData.thing.getFrameGroup(FrameGroupType.DEFAULT);
                if (!frameGroup) return null;

                var size:uint = SpriteExtent.DEFAULT_SIZE;
                var fgWidth:uint = frameGroup.width;
                var fgHeight:uint = frameGroup.height;

                var totalW:uint = fgWidth * size;
                var totalH:uint = fgHeight * size;

                var f:uint = Math.min(_currentFrame, frameGroup.frames - 1);
                var l:uint = Math.min(_currentLayer, frameGroup.layers - 1);
                var patX:uint = _currentPatX % frameGroup.patternX;
                var patY:uint = _currentPatY % frameGroup.patternY;
                var z:uint = 0;

                var rect32:Rectangle = new Rectangle(0, 0, size, size);
                var pt:Point = new Point();

                var composite:BitmapData = new BitmapData(totalW, totalH, true, 0x00000000);

                for (var w:uint = 0; w < fgWidth; w++)
                {
                    for (var h:uint = 0; h < fgHeight; h++)
                    {
                        var index:int = frameGroup.getSpriteIndex(w, h, l, patX, patY, z, f);
                        var spritesList:Vector.<SpriteData> = _thingData.sprites[_currentGroupType];
                        if (!spritesList)
                            spritesList = _thingData.sprites[FrameGroupType.DEFAULT];

                        if (spritesList && index >= 0 && index < spritesList.length)
                        {
                            var sd:SpriteData = spritesList[index];
                            if (sd && !sd.isEmpty())
                            {
                                var bmp:BitmapData = sd.getBitmap();
                                if (bmp)
                                {
                                    pt.x = (fgWidth - w - 1) * size;
                                    pt.y = (fgHeight - h - 1) * size;
                                    composite.copyPixels(bmp, rect32, pt, null, null, true);
                                    bmp.dispose();
                                }
                            }
                        }
                    }
                }

                return composite;
            }

            public function updatePreview():void
            {
                if (!_baseBitmap)
                    _baseBitmap = composePreviewBitmap();

                if (!_baseBitmap || !previewImage) return;

                if (_recoloredBitmap)
                {
                    _recoloredBitmap.dispose();
                    _recoloredBitmap = null;
                }

                _recoloredBitmap = RecolorUtils.recolorBitmap(
                    _baseBitmap,
                    enableHslCheckBox.selected,
                    hueSlider.value,
                    satSlider.value,
                    lightSlider.value,
                    colorizeCheckBox.selected,
                    enableReplaceCheckBox.selected,
                    _sourceColor,
                    _targetColor,
                    toleranceSlider.value,
                    preserveShadingCheckBox.selected,
                    _useMask,
                    _maskBitmap
                );

                previewImage.source = _recoloredBitmap;
                previewImage.width = _baseBitmap.width * _previewScale;
                previewImage.height = _baseBitmap.height * _previewScale;

                updateMaskOverlay();
            }

            public function updateMaskOverlay():void
            {
                if (!_maskBitmap || !_maskOverlayBitmap || !maskOverlayImage) return;

                _maskOverlayBitmap.lock();
                var w:int = _maskBitmap.width;
                var h:int = _maskBitmap.height;

                for (var y:int = 0; y < h; y++)
                {
                    for (var x:int = 0; x < w; x++)
                    {
                        if ((_maskBitmap.getPixel32(x, y) & 0x00FFFFFF) != 0)
                        {
                            // 50% opacity electric cyan highlight (0x8000E5FF)
                            _maskOverlayBitmap.setPixel32(x, y, 0x8000E5FF);
                        }
                        else
                        {
                            _maskOverlayBitmap.setPixel32(x, y, 0x00000000);
                        }
                    }
                }
                _maskOverlayBitmap.unlock();

                maskOverlayImage.source = _maskOverlayBitmap;
                maskOverlayImage.width = _maskBitmap.width * _previewScale;
                maskOverlayImage.height = _maskBitmap.height * _previewScale;
                maskOverlayImage.visible = _showMaskOverlay && _useMask;
            }

            // --------------------------------------------------------------------------
            // MOUSE & TOOL ACTIONS
            // --------------------------------------------------------------------------

            private function getPixelCoords(event:MouseEvent):Point
            {
                if (!_baseBitmap) return null;
                var px:int = int(event.localX / _previewScale);
                var py:int = int(event.localY / _previewScale);
                if (px < 0) px = 0;
                if (py < 0) py = 0;
                if (px >= _baseBitmap.width) px = _baseBitmap.width - 1;
                if (py >= _baseBitmap.height) py = _baseBitmap.height - 1;
                return new Point(px, py);
            }

            private function onPreviewMouseDown(event:MouseEvent):void
            {
                if (!_baseBitmap) return;
                var pt:Point = getPixelCoords(event);
                if (!pt) return;
                var px:int = pt.x;
                var py:int = pt.y;

                _isMouseDown = true;

                if (_activeTool == TOOL_EYEDROPPER)
                {
                    pickColorAt(px, py);
                    return;
                }

                if (_activeTool == TOOL_WAND)
                {
                    ensureMaskExists();
                    pushMaskHistory();
                    var markedCount:uint = RecolorUtils.magicWandSelect(_baseBitmap, _maskBitmap, px, py, toleranceSlider.value);
                    if (markedCount > 0)
                    {
                        _useMask = true;
                        enableMaskCheckBox.selected = true;
                    }
                    updateMaskOverlay();
                    updatePreview();
                    return;
                }

                if (_activeTool == TOOL_RECT)
                {
                    _rectStartX = px;
                    _rectStartY = py;
                    return;
                }

                if (_activeTool == TOOL_BRUSH || _activeTool == TOOL_ERASER)
                {
                    ensureMaskExists();
                    if (!_maskStrokeActive)
                    {
                        pushMaskHistory();
                        _maskStrokeActive = true;
                    }
                    applyBrushAt(px, py, (_activeTool == TOOL_BRUSH));
                    if (_activeTool == TOOL_BRUSH)
                    {
                        _useMask = true;
                        enableMaskCheckBox.selected = true;
                    }
                    updateMaskOverlay();
                    updatePreview();
                }
            }

            private function onPreviewMouseMove(event:MouseEvent):void
            {
                if (!_isMouseDown || !_baseBitmap) return;

                var pt:Point = getPixelCoords(event);
                if (!pt) return;
                var px:int = pt.x;
                var py:int = pt.y;

                if (_activeTool == TOOL_BRUSH || _activeTool == TOOL_ERASER)
                {
                    ensureMaskExists();
                    applyBrushAt(px, py, (_activeTool == TOOL_BRUSH));
                    updateMaskOverlay();
                    updatePreview();
                }
            }

            private function onPreviewMouseUp(event:MouseEvent):void
            {
                if (!_isMouseDown) return;
                _isMouseDown = false;
                _maskStrokeActive = false;

                if (_activeTool == TOOL_RECT && _rectStartX >= 0 && _rectStartY >= 0)
                {
                    var pt:Point = getPixelCoords(event);
                    if (pt)
                    {
                        ensureMaskExists();
                        pushMaskHistory();
                        var minX:int = Math.min(_rectStartX, pt.x);
                        var maxX:int = Math.max(_rectStartX, pt.x);
                        var minY:int = Math.min(_rectStartY, pt.y);
                        var maxY:int = Math.max(_rectStartY, pt.y);

                        for (var y:int = minY; y <= maxY; y++)
                        {
                            for (var x:int = minX; x <= maxX; x++)
                            {
                                var alpha:uint = (_baseBitmap.getPixel32(x, y) >> 24) & 0xFF;
                                if (alpha > 0)
                                {
                                    _maskBitmap.setPixel32(x, y, 0xFFFFFFFF);
                                }
                            }
                        }
                        _useMask = true;
                        enableMaskCheckBox.selected = true;
                        updateMaskOverlay();
                        updatePreview();
                    }
                    _rectStartX = -1;
                    _rectStartY = -1;
                }
            }

            private function applyBrushAt(px:int, py:int, mark:Boolean):void
            {
                var half:int = int(_brushSize / 2);
                var color:uint = mark ? 0xFFFFFFFF : 0x00000000;
                for (var ox:int = -half; ox <= half; ox++)
                {
                    for (var oy:int = -half; oy <= half; oy++)
                    {
                        var gx:int = px + ox;
                        var gy:int = py + oy;
                        if (gx >= 0 && gx < _maskBitmap.width && gy >= 0 && gy < _maskBitmap.height)
                        {
                            if (!mark || ((_baseBitmap.getPixel32(gx, gy) >> 24) & 0xFF) > 0)
                            {
                                _maskBitmap.setPixel32(gx, gy, color);
                            }
                        }
                    }
                }
            }

            private function pickColorAt(px:int, py:int):void
            {
                if (!_baseBitmap) return;
                var p:uint = _baseBitmap.getPixel32(px, py);
                var alpha:uint = (p >> 24) & 0xFF;
                if (alpha > 0)
                {
                    var rgb:uint = p & 0x00FFFFFF;
                    if (rgb != 0x00FF00FF)
                    {
                        _sourceColor = rgb;
                        _sourceHex = padHex(rgb.toString(16).toUpperCase());
                        sourceColorPicker.selectedColor = _sourceColor;
                        enableReplaceCheckBox.selected = true;
                        addColorToHistory(rgb);
                        updatePreview();
                    }
                }
            }

            public function selectAllMask():void
            {
                ensureMaskExists();
                pushMaskHistory();
                for (var y:int = 0; y < _baseBitmap.height; y++)
                {
                    for (var x:int = 0; x < _baseBitmap.width; x++)
                    {
                        if (((_baseBitmap.getPixel32(x, y) >> 24) & 0xFF) > 0)
                            _maskBitmap.setPixel32(x, y, 0xFFFFFFFF);
                    }
                }
                _useMask = true;
                enableMaskCheckBox.selected = true;
                updateMaskOverlay();
                updatePreview();
            }

            public function clearMask():void
            {
                if (!_maskBitmap)
                    return;
                pushMaskHistory();
                _maskBitmap.fillRect(_maskBitmap.rect, 0x00000000);
                updateMaskOverlay();
                updatePreview();
            }

            public function invertMask():void
            {
                ensureMaskExists();
                pushMaskHistory();
                for (var y:int = 0; y < _baseBitmap.height; y++)
                {
                    for (var x:int = 0; x < _baseBitmap.width; x++)
                    {
                        if (((_baseBitmap.getPixel32(x, y) >> 24) & 0xFF) > 0)
                        {
                            var isSet:Boolean = ((_maskBitmap.getPixel32(x, y) & 0x00FFFFFF) != 0);
                            _maskBitmap.setPixel32(x, y, isSet ? 0x00000000 : 0xFFFFFFFF);
                        }
                        else
                        {
                            _maskBitmap.setPixel32(x, y, 0x00000000);
                        }
                    }
                }
                _useMask = true;
                enableMaskCheckBox.selected = true;
                updateMaskOverlay();
                updatePreview();
            }

            private function setTool(tool:String):void
            {
                _activeTool = tool;
                updateToolButtons();
            }

            private function updateToolButtons():void
            {
                wandBtn.selected = (_activeTool == TOOL_WAND);
                brushBtn.selected = (_activeTool == TOOL_BRUSH);
                eraserBtn.selected = (_activeTool == TOOL_ERASER);
                rectBtn.selected = (_activeTool == TOOL_RECT);
                eyedropperBtn.selected = (_activeTool == TOOL_EYEDROPPER);
            }

            private function onBrushSizeChange(size:uint):void
            {
                _brushSize = size;
                bSize1Btn.selected = (size == 1);
                bSize2Btn.selected = (size == 2);
                bSize3Btn.selected = (size == 3);
                bSize4Btn.selected = (size == 4);
            }

            private function onMaskEnableChange():void
            {
                _useMask = enableMaskCheckBox.selected;
                updateMaskOverlay();
                updatePreview();
            }

            private function onShowOverlayChange():void
            {
                _showMaskOverlay = showOverlayCheckBox.selected;
                updateMaskOverlay();
            }

            private function padHex(hex:String):String
            {
                while (hex.length < 6) hex = "0" + hex;
                return hex;
            }

            private function onSourceColorChange(event:ColorPickerEvent):void
            {
                _sourceColor = event.color;
                _sourceHex = padHex(_sourceColor.toString(16).toUpperCase());
                addColorToHistory(_sourceColor);
                updatePreview();
            }

            private function onTargetColorChange(event:ColorPickerEvent):void
            {
                _targetColor = event.color;
                _targetHex = padHex(_targetColor.toString(16).toUpperCase());
                updatePreview();
            }

            private function onSourceHexChange():void
            {
                var clean:String = sourceHexInput.text.replace(/[^0-9A-Fa-f]/g, "");
                if (clean.length == 6)
                {
                    _sourceColor = parseInt(clean, 16);
                    _sourceHex = clean.toUpperCase();
                    sourceColorPicker.selectedColor = _sourceColor;
                    addColorToHistory(_sourceColor);
                    updatePreview();
                }
            }

            private function onTargetHexChange():void
            {
                var clean:String = targetHexInput.text.replace(/[^0-9A-Fa-f]/g, "");
                if (clean.length == 6)
                {
                    _targetColor = parseInt(clean, 16);
                    _targetHex = clean.toUpperCase();
                    targetColorPicker.selectedColor = _targetColor;
                    updatePreview();
                }
            }

            private function setDirection(dir:uint):void
            {
                saveCurrentMaskToView();
                var isOutfit:Boolean = (_thingData && _thingData.category == ThingCategory.OUTFIT);
                switch(dir)
                {
                    case Direction.NORTH.value:
                        _currentPatX = isOutfit ? 0 : 1;
                        _currentPatY = 0;
                        break;
                    case Direction.EAST.value:
                        _currentPatX = isOutfit ? 1 : 2;
                        _currentPatY = isOutfit ? 0 : 1;
                        break;
                    case Direction.SOUTH.value:
                        _currentPatX = isOutfit ? 2 : 1;
                        _currentPatY = isOutfit ? 0 : 2;
                        break;
                    case Direction.WEST.value:
                        _currentPatX = isOutfit ? 3 : 0;
                        _currentPatY = isOutfit ? 0 : 1;
                        break;
                }
                updateDirectionButtons();
                rebuildBaseBitmap();
                if (!_applyMaskToAll)
                    restoreMaskForView();
                updateMaskOverlay();
                updatePreview();
            }

            private function updateDirectionButtons():void
            {
                var isOutfit:Boolean = (_thingData && _thingData.category == ThingCategory.OUTFIT);
                btnNorth.selected = (_currentPatX == (isOutfit ? 0 : 1) && _currentPatY == 0);
                btnEast.selected = (_currentPatX == (isOutfit ? 1 : 2) && _currentPatY == (isOutfit ? 0 : 1));
                btnSouth.selected = (_currentPatX == (isOutfit ? 2 : 1) && _currentPatY == (isOutfit ? 0 : 2));
                btnWest.selected = (_currentPatX == (isOutfit ? 3 : 0) && _currentPatY == (isOutfit ? 0 : 1));
            }

            private function onFrameChange():void
            {
                saveCurrentMaskToView();
                _currentFrame = frameSlider.value;
                rebuildBaseBitmap();
                if (!_applyMaskToAll)
                    restoreMaskForView();
                updateMaskOverlay();
                updatePreview();
            }

            private function onScaleChange(scale:Number):void
            {
                _previewScale = scale;
                scale1Btn.selected = (scale == 1.0);
                scale2Btn.selected = (scale == 2.0);
                scale3Btn.selected = (scale == 3.0);
                scale4Btn.selected = (scale == 4.0);
                updatePreview();
            }

            private function resetAll():void
            {
                enableHslCheckBox.selected = true;
                hueSlider.value = 0;
                satSlider.value = 0;
                lightSlider.value = 0;
                colorizeCheckBox.selected = false;

                enableReplaceCheckBox.selected = false;
                _sourceColor = 0xFF0000;
                _targetColor = 0x0088FF;
                _sourceHex = "FF0000";
                _targetHex = "0088FF";
                sourceColorPicker.selectedColor = _sourceColor;
                targetColorPicker.selectedColor = _targetColor;
                toleranceSlider.value = 15;
                preserveShadingCheckBox.selected = true;

                _useMask = false;
                enableMaskCheckBox.selected = false;
                if (_maskBitmap)
                    _maskBitmap.fillRect(_maskBitmap.rect, 0x00000000);
                clearMaskHistory();
                updateMaskOverlay();

                updatePreview();
            }

            private function getRecoloredThingData():ThingData
            {
                return RecolorUtils.recolorThingData(
                    _thingData,
                    enableHslCheckBox.selected,
                    hueSlider.value,
                    satSlider.value,
                    lightSlider.value,
                    colorizeCheckBox.selected,
                    enableReplaceCheckBox.selected,
                    _sourceColor,
                    _targetColor,
                    toleranceSlider.value,
                    preserveShadingCheckBox.selected,
                    _useMask,
                    _maskBitmap,
                    _applyMaskToAll,
                    _masksByView
                );
            }

            private function handleReplaceCurrent():void
            {
                saveCurrentMaskToView();
                var recolored:ThingData = getRecoloredThingData();
                if (onSave != null)
                {
                    onSave(recolored, false);
                }
                this.close();
            }

            private function handleCreateNew():void
            {
                saveCurrentMaskToView();
                var recolored:ThingData = getRecoloredThingData();
                if (onSave != null)
                {
                    onSave(recolored, true);
                }
                this.close();
            }
        ]]>
    </fx:Script>

    <!-- Main Split Layout: Left Preview & Mask Tools, Right Color Settings -->
    <s:HGroup width="100%" height="100%" gap="16">

        <!-- Left Column: Preview + Mask Selection Toolbar -->
        <s:VGroup width="360" height="100%" gap="8">
            <s:Label text="{_objectInfo}" fontWeight="bold" fontSize="13" color="0xFFFFFF"/>

            <!-- Checkerboard Preview Container with Mask Overlay -->
            <s:BorderContainer width="100%" height="280" backgroundColor="0x282828" borderColor="0x202020" borderWeight="1" cornerRadius="4">
                <s:layout>
                    <s:BasicLayout/>
                </s:layout>

                <!-- Checkerboard Background -->
                <otlib:CheckerBoard width="100%" height="100%" cellSize="16"/>

                <!-- Centered Preview Image & Overlay -->
                <s:Group horizontalCenter="0" verticalCenter="0">
                    <s:Image id="previewImage"
                        scaleMode="letterbox"
                        smooth="false"
                        useHandCursor="true"
                        buttonMode="true"
                        mouseDown="onPreviewMouseDown(event)"
                        mouseMove="onPreviewMouseMove(event)"
                        mouseUp="onPreviewMouseUp(event)"/>
                    <s:Image id="maskOverlayImage"
                        scaleMode="letterbox"
                        smooth="false"
                        mouseEnabled="false"
                        mouseChildren="false"/>
                </s:Group>
            </s:BorderContainer>

            <!-- Preview Controls: Zoom -->
            <s:HGroup width="100%" verticalAlign="middle" gap="6">
                <s:Label text="Zoom:" color="0xCCCCCC"/>
                <s:ToggleButton id="scale1Btn" label="1x" width="34" height="22" click="onScaleChange(1.0)"/>
                <s:ToggleButton id="scale2Btn" label="2x" width="34" height="22" selected="true" click="onScaleChange(2.0)"/>
                <s:ToggleButton id="scale3Btn" label="3x" width="34" height="22" click="onScaleChange(3.0)"/>
                <s:ToggleButton id="scale4Btn" label="4x" width="34" height="22" click="onScaleChange(4.0)"/>
                <s:Spacer width="100%"/>
                <s:CheckBox id="showOverlayCheckBox"
                    label="@Resource(key='showOverlay', bundle='strings')"
                    selected="{_showMaskOverlay}"
                    change="onShowOverlayChange()"/>
            </s:HGroup>

            <!-- Mask Tools Toolbar -->
            <s:BorderContainer width="100%" backgroundColor="0x2C2C2C" borderColor="0x202020" cornerRadius="4">
                <s:layout>
                    <s:VerticalLayout paddingLeft="8" paddingRight="8" paddingTop="6" paddingBottom="8" gap="6"/>
                </s:layout>

                <!-- Tools Row -->
                <s:HGroup width="100%" verticalAlign="middle" gap="4">
                    <s:ToggleButton id="wandBtn"
                        label="@Resource(key='toolWand', bundle='strings')"
                        toolTip="Varinha Mágica: Clica na parte conectada (ex: bainha, capa, camisa) para selecionar instantaneamente"
                        selected="true"
                        height="24"
                        click="setTool(TOOL_WAND)"/>
                    <s:ToggleButton id="brushBtn"
                        label="@Resource(key='toolBrush', bundle='strings')"
                        toolTip="Pincel: Pinte livremente os pixels que quer recolorir"
                        height="24"
                        click="setTool(TOOL_BRUSH)"/>
                    <s:ToggleButton id="eraserBtn"
                        label="@Resource(key='toolEraser', bundle='strings')"
                        toolTip="Borracha: Desmarca pixels da seleção"
                        height="24"
                        click="setTool(TOOL_ERASER)"/>
                    <s:ToggleButton id="rectBtn"
                        label="@Resource(key='toolRect', bundle='strings')"
                        toolTip="Retângulo: Arraste para selecionar uma área quadrada/retangular"
                        height="24"
                        click="setTool(TOOL_RECT)"/>
                    <s:ToggleButton id="eyedropperBtn"
                        label="@Resource(key='pickColor', bundle='strings')"
                        toolTip="Conta-Gotas: Pega a cor sob o clique para a substituição de cor"
                        height="24"
                        click="setTool(TOOL_EYEDROPPER)"/>
                </s:HGroup>

                <!-- Brush Size & Mask Quick Actions -->
                <s:HGroup width="100%" verticalAlign="middle" gap="6">
                    <s:Label text="@Resource(key='brushSize', bundle='strings')" color="0xBBBBBB"/>
                    <s:ToggleButton id="bSize1Btn" label="1" width="24" height="20" selected="true" click="onBrushSizeChange(1)"/>
                    <s:ToggleButton id="bSize2Btn" label="2" width="24" height="20" click="onBrushSizeChange(2)"/>
                    <s:ToggleButton id="bSize3Btn" label="3" width="24" height="20" click="onBrushSizeChange(3)"/>
                    <s:ToggleButton id="bSize4Btn" label="4" width="24" height="20" click="onBrushSizeChange(4)"/>

                    <s:Spacer width="100%"/>

                    <s:Button id="undoMaskBtn"
                        label="@Resource(key='undoMask', bundle='strings')"
                        toolTip="Ctrl+Z"
                        height="20"
                        enabled="{_canUndoMask}"
                        click="undoMask()"/>
                    <s:Button id="redoMaskBtn"
                        label="@Resource(key='redoMask', bundle='strings')"
                        toolTip="Ctrl+Y"
                        height="20"
                        enabled="{_canRedoMask}"
                        click="redoMask()"/>
                    <s:Button id="selectAllBtn"
                        label="@Resource(key='selectAllMask', bundle='strings')"
                        height="20"
                        click="selectAllMask()"/>
                    <s:Button id="clearMaskBtn"
                        label="@Resource(key='clearMask', bundle='strings')"
                        height="20"
                        click="clearMask()"/>
                    <s:Button id="invertMaskBtn"
                        label="@Resource(key='invertMask', bundle='strings')"
                        height="20"
                        click="invertMask()"/>
                </s:HGroup>
            </s:BorderContainer>

            <!-- Direction Buttons (For Outfits / Missiles) -->
            <s:HGroup width="100%" verticalAlign="middle" gap="6" visible="{_hasDirections}" includeInLayout="{_hasDirections}">
                <s:Label text="Direção:" color="0xCCCCCC"/>
                <s:ToggleButton id="btnNorth" label="N" width="32" height="22" click="setDirection(Direction.NORTH.value)"/>
                <s:ToggleButton id="btnEast" label="E" width="32" height="22" click="setDirection(Direction.EAST.value)"/>
                <s:ToggleButton id="btnSouth" label="S" width="32" height="22" selected="true" click="setDirection(Direction.SOUTH.value)"/>
                <s:ToggleButton id="btnWest" label="W" width="32" height="22" click="setDirection(Direction.WEST.value)"/>
            </s:HGroup>

            <!-- Animation Frame Slider (For Animated Items / Effects) -->
            <s:HGroup width="100%" verticalAlign="middle" gap="6" visible="{_hasFrames}" includeInLayout="{_hasFrames}">
                <s:Label text="Frame:" color="0xCCCCCC"/>
                <s:HSlider id="frameSlider"
                    width="100%"
                    minimum="0"
                    maximum="{_maxFrames - 1}"
                    stepSize="1"
                    value="0"
                    liveDragging="true"
                    change="onFrameChange()"/>
                <s:Label text="{frameSlider.value + 1} / {_maxFrames}" color="0xAAAAAA" width="35"/>
            </s:HGroup>
        </s:VGroup>

        <!-- Right Column: Recolor Settings -->
        <s:VGroup width="100%" height="100%" gap="10">

            <!-- Section 0: Ativação da Área Marcada (Selection Mask Toggle) -->
            <s:BorderContainer width="100%" backgroundColor="0x26333D" borderColor="0x1D4A6E" borderWeight="1" cornerRadius="4">
                <s:layout>
                    <s:VerticalLayout paddingLeft="10" paddingRight="10" paddingTop="8" paddingBottom="8" gap="6"/>
                </s:layout>

                <s:HGroup width="100%" verticalAlign="middle">
                    <s:CheckBox id="enableMaskCheckBox"
                        label="@Resource(key='enableAreaMask', bundle='strings')"
                        selected="{_useMask}"
                        fontWeight="bold"
                        fontSize="12"
                        color="0x40C4FF"
                        change="onMaskEnableChange()"/>
                    <s:Spacer width="100%"/>
                    <s:CheckBox id="applyAllFramesCheckBox"
                        label="@Resource(key='applyMaskAllFrames', bundle='strings')"
                        selected="{_applyMaskToAll}"
                        color="0xCCCCCC"
                        change="{_applyMaskToAll = applyAllFramesCheckBox.selected}"/>
                </s:HGroup>
                <s:HGroup width="100%" verticalAlign="middle" gap="8">
                    <s:Button id="copyMaskAllBtn"
                        label="@Resource(key='copyMaskAllFrames', bundle='strings')"
                        height="22"
                        click="copyMaskToAllViews()"/>
                    <s:Label text="@Resource(key='recolorAppliesAllFrames', bundle='strings')"
                        color="0x90CAF9" fontSize="10" width="100%"/>
                </s:HGroup>
            </s:BorderContainer>

            <!-- Color Presets -->
            <s:BorderContainer width="100%" backgroundColor="0x2E2E2E" borderColor="0x222222" cornerRadius="4">
                <s:layout>
                    <s:VerticalLayout paddingLeft="10" paddingRight="10" paddingTop="8" paddingBottom="8" gap="6"/>
                </s:layout>
                <s:Label text="@Resource(key='colorPresets', bundle='strings')" fontWeight="bold" color="0xFFFFFF"/>
                <s:HGroup width="100%" gap="6">
                    <s:Button label="@Resource(key='presetShiny', bundle='strings')" height="24" click="applyPreset('shiny')"/>
                    <s:Button label="@Resource(key='presetFire', bundle='strings')" height="24" click="applyPreset('fire')"/>
                    <s:Button label="@Resource(key='presetIce', bundle='strings')" height="24" click="applyPreset('ice')"/>
                    <s:Button label="@Resource(key='presetPoison', bundle='strings')" height="24" click="applyPreset('poison')"/>
                    <s:Button label="@Resource(key='presetShadow', bundle='strings')" height="24" click="applyPreset('shadow')"/>
                    <s:Button label="@Resource(key='presetBlood', bundle='strings')" height="24" click="applyPreset('blood')"/>
                </s:HGroup>
            </s:BorderContainer>

            <!-- Section 1: Matiz e Saturação (HSL) -->
            <s:BorderContainer width="100%" backgroundColor="0x2E2E2E" borderColor="0x222222" cornerRadius="4">
                <s:layout>
                    <s:VerticalLayout paddingLeft="10" paddingRight="10" paddingTop="8" paddingBottom="10" gap="8"/>
                </s:layout>

                <s:HGroup width="100%" verticalAlign="middle">
                    <s:CheckBox id="enableHslCheckBox"
                        label="@Resource(key='enableHsl', bundle='strings')"
                        selected="true"
                        fontWeight="bold"
                        fontSize="12"
                        change="updatePreview()"/>
                    <s:Spacer width="100%"/>
                    <s:CheckBox id="colorizeCheckBox"
                        label="@Resource(key='colorize', bundle='strings')"
                        selected="false"
                        enabled="{enableHslCheckBox.selected}"
                        change="updatePreview()"/>
                </s:HGroup>

                <!-- Hue Slider (-180 to 180) -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableHslCheckBox.selected}">
                    <s:Label text="@Resource(key='hue', bundle='strings')" width="70" color="0xDDDDDD"/>
                    <s:HSlider id="hueSlider"
                        width="100%"
                        minimum="{colorizeCheckBox.selected ? 0 : -180}"
                        maximum="{colorizeCheckBox.selected ? 360 : 180}"
                        stepSize="1"
                        value="0"
                        liveDragging="true"
                        change="updatePreview()"/>
                    <s:Label text="{hueSlider.value}°" width="45" textAlign="right" color="0xEEEEEE"/>
                </s:HGroup>

                <!-- Saturation Slider (-100 to 100) -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableHslCheckBox.selected}">
                    <s:Label text="@Resource(key='saturation', bundle='strings')" width="70" color="0xDDDDDD"/>
                    <s:HSlider id="satSlider"
                        width="100%"
                        minimum="{colorizeCheckBox.selected ? 0 : -100}"
                        maximum="100"
                        stepSize="1"
                        value="0"
                        liveDragging="true"
                        change="updatePreview()"/>
                    <s:Label text="{satSlider.value}%" width="45" textAlign="right" color="0xEEEEEE"/>
                </s:HGroup>

                <!-- Lightness Slider (-100 to 100) -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableHslCheckBox.selected}">
                    <s:Label text="@Resource(key='lightness', bundle='strings')" width="70" color="0xDDDDDD"/>
                    <s:HSlider id="lightSlider"
                        width="100%"
                        minimum="-100"
                        maximum="100"
                        stepSize="1"
                        value="0"
                        liveDragging="true"
                        change="updatePreview()"/>
                    <s:Label text="{lightSlider.value}%" width="45" textAlign="right" color="0xEEEEEE"/>
                </s:HGroup>
            </s:BorderContainer>

            <!-- Section 2: Substituir Cor (Replace Color) -->
            <s:BorderContainer width="100%" backgroundColor="0x2E2E2E" borderColor="0x222222" cornerRadius="4">
                <s:layout>
                    <s:VerticalLayout paddingLeft="10" paddingRight="10" paddingTop="8" paddingBottom="10" gap="8"/>
                </s:layout>

                <s:CheckBox id="enableReplaceCheckBox"
                    label="@Resource(key='enableReplace', bundle='strings')"
                    selected="false"
                    fontWeight="bold"
                    fontSize="12"
                    change="updatePreview()"/>

                <!-- Source Color Row -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableReplaceCheckBox.selected}">
                    <s:Label text="@Resource(key='sourceColor', bundle='strings')" width="100" color="0xDDDDDD"/>
                    <mx:ColorPicker id="sourceColorPicker"
                        selectedColor="{_sourceColor}"
                        change="onSourceColorChange(event)"/>
                    <s:BorderContainer width="24" height="24" backgroundColor="{_sourceColor}" borderColor="0x111111" cornerRadius="3"/>
                    <s:Label text="#" color="0x888888"/>
                    <s:TextInput id="sourceHexInput"
                        text="{_sourceHex}"
                        width="65"
                        maxChars="6"
                        change="onSourceHexChange()"/>
                </s:HGroup>

                <!-- Eyedropper color history -->
                <s:HGroup width="100%" verticalAlign="middle" gap="6" enabled="{enableReplaceCheckBox.selected}">
                    <s:Label text="@Resource(key='colorHistory', bundle='strings')" width="100" color="0xDDDDDD"/>
                    <s:HGroup id="colorHistoryGroup" gap="4" verticalAlign="middle"/>
                </s:HGroup>

                <!-- Target Color Row -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableReplaceCheckBox.selected}">
                    <s:Label text="@Resource(key='targetColor', bundle='strings')" width="100" color="0xDDDDDD"/>
                    <mx:ColorPicker id="targetColorPicker"
                        selectedColor="{_targetColor}"
                        change="onTargetColorChange(event)"/>
                    <s:BorderContainer width="24" height="24" backgroundColor="{_targetColor}" borderColor="0x111111" cornerRadius="3"/>
                    <s:Label text="#" color="0x888888"/>
                    <s:TextInput id="targetHexInput"
                        text="{_targetHex}"
                        width="65"
                        maxChars="6"
                        change="onTargetHexChange()"/>
                </s:HGroup>

                <!-- Tolerance Slider (0 to 100) -->
                <s:HGroup width="100%" verticalAlign="middle" gap="8" enabled="{enableReplaceCheckBox.selected}">
                    <s:Label text="@Resource(key='tolerance', bundle='strings')" width="100" color="0xDDDDDD"/>
                    <s:HSlider id="toleranceSlider"
                        width="100%"
                        minimum="0"
                        maximum="100"
                        stepSize="1"
                        value="15"
                        liveDragging="true"
                        change="updatePreview()"/>
                    <s:Label text="{toleranceSlider.value}%" width="45" textAlign="right" color="0xEEEEEE"/>
                </s:HGroup>

                <!-- Preserve Shading Toggle -->
                <s:HGroup width="100%" verticalAlign="middle" enabled="{enableReplaceCheckBox.selected}">
                    <s:CheckBox id="preserveShadingCheckBox"
                        label="@Resource(key='preserveShading', bundle='strings')"
                        selected="true"
                        change="updatePreview()"/>
                </s:HGroup>
            </s:BorderContainer>

            <s:Spacer height="100%"/>

            <!-- Action Buttons: Reset, Create New, Replace Current, Cancel -->
            <s:HGroup width="100%" verticalAlign="middle" gap="8">
                <s:Button id="resetButton"
                    label="@Resource(key='reset', bundle='strings')"
                    height="28"
                    click="resetAll()"/>

                <s:Spacer width="100%"/>

                <s:Button id="btnCreateNew"
                    label="@Resource(key='saveAsNew', bundle='strings')"
                    height="28"
                    fontWeight="bold"
                    chromeColor="0x2E6B9E"
                    color="0xFFFFFF"
                    click="handleCreateNew()"/>

                <s:Button id="btnReplaceCurrent"
                    label="@Resource(key='replaceCurrent', bundle='strings')"
                    height="28"
                    fontWeight="bold"
                    chromeColor="0x8C5228"
                    color="0xFFFFFF"
                    click="handleReplaceCurrent()"/>

                <s:Button id="cancelButton"
                    label="@Resource(key='cancel', bundle='strings')"
                    height="28"
                    click="this.close()"/>
            </s:HGroup>
        </s:VGroup>
    </s:HGroup>
</s:Window>